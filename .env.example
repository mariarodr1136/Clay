DATABASE_URL=postgresql://clay:clay@localhost:5432/clay

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional. Signs the short-lived tokens that let the PDF exporter's headless
# browser load an authenticated view, and the cookie that identifies a /demo
# visitor's throwaway workspace. Falls back to CLERK_SECRET_KEY when unset,
# so both work without extra configuration.
PDF_SIGNING_SECRET=

# Optional, production only. Vercel sends this as a bearer token on scheduled
# cron invocations; when set, /api/cron/sweep-guests requires it. Leaving it
# unset only means the sweep endpoint is callable by anyone — and all it can
# do is delete demo workspaces that have already expired.
CRON_SECRET=
